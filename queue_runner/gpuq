    return job


def derive_name(command: str, job_id: int | None = None) -> str:
    token = shlex.split(command)[0] if command.strip() else "job"
    stem = Path(token).name or "job"
    return stem if job_id is None else f"{stem}-{job_id}"


def render_job_status(status: str) -> str:
    st = STATUS_STYLES.get(status, {"color": "gray", "symbol": "?", "label": status})
    return f"{st['symbol']} {style(st['label'], st['color'], bold=status == 'running')}"


def priority_symbol(priority: int) -> str:
    if priority >= 10:
        return style("▲", "bright_red")
    if priority >= 5:
        return style("▲", "bright_yellow")
    if priority >= 1:
        return style("▲", "bright_cyan")
    if priority <= -10:
        return style("▼", "gray", dim=True)
    if priority <= -5:
        return style("▼", "gray", dim=True)
    return style("─", "gray", dim=True)


def render_gpu_bar(util: int, width: int = 10) -> str:
    filled = min(width, max(0, round(util / 100 * width)))
    empty = width - filled
    if util >= 80:
        color = "red"
    elif util >= 50:
        color = "yellow"
    elif util >= 10:
        color = "green"
    else:
        color = "gray"
    bar = "█" * filled + "░" * empty
    return style(f"[{bar}]", color)


def queue_color(queue_name: str) -> str:
    h = hash(queue_name) % len(QUEUE_COLORS)
    return QUEUE_COLORS[abs(h)]


def render_summary(state: dict[str, Any]) -> str:
    counts: dict[str, int] = {}
    for job in state["jobs"]:
        s = job["status"]
        counts[s] = counts.get(s, 0) + 1
    parts = []
    total = len(state["jobs"])
    parts.append(f"total {total}")
    for status, st in STATUS_STYLES.items():
        if status in counts:
            parts.append(f"{st['symbol']} {counts[status]} {st['label']}")
    return "  ".join(parts)


def gpu_idle_reason(job: dict[str, Any], metrics: list[dict[str, Any]]) -> tuple[bool, list[str]]:
    wanted = set(job["gpus"])
    available = {item["index"]: item for item in metrics}
    reasons = []
    for gpu_id in job["gpus"]:
        if gpu_id not in available:
            reasons.append(f"GPU {gpu_id} 不存在")
            continue
        gpu = available[gpu_id]
        if gpu["util"] > job["idle_util_threshold"]:
            reasons.append(f"GPU {gpu_id} util={gpu['util']}%")
        if gpu["mem_used"] > job["idle_mem_threshold_mb"]:
            reasons.append(f"GPU {gpu_id} mem={gpu['mem_used']}MB")
    missing = wanted - set(available)
    for gpu_id in sorted(missing):
        reasons.append(f"GPU {gpu_id} 缺失")
    return (len(reasons) == 0, reasons)


def run_metadata_paths(job_id: int) -> tuple[Path, Path, Path]:
    stamp = now().strftime("%Y%m%d-%H%M%S")
    run_dir = RUN_DIR / f"job-{job_id}-{stamp}"
    log_path = run_dir / "job.log"
    exit_path = run_dir / "exit_code.txt"
    return run_dir, log_path, exit_path


def build_wrapper_script(job: dict[str, Any], run_dir: Path, log_path: Path, exit_path: Path) -> Path:
    script_path = run_dir / "launch.sh"
    exports = ""
    if job["set_cuda_visible_devices"]:
        exports = f"export CUDA_VISIBLE_DEVICES={shlex.quote(','.join(str(g) for g in job['gpus']))}\n"
    # Always source conda.sh so conda activate works in non-interactive shell
    conda_init = (
        'CONDA_BASE=$(conda info --base 2>/dev/null)\n'
        'if [ -n "$CONDA_BASE" ] && [ -f "$CONDA_BASE/etc/profile.d/conda.sh" ]; then\n'
        '  source "$CONDA_BASE/etc/profile.d/conda.sh"\n'
        'fi\n'
    )
    conda_activate = ""
    echo_env = ""
    if job.get("conda_env"):
        conda_env_name = shlex.quote(job["conda_env"])
        conda_activate = f"conda activate {conda_env_name}\n"
        echo_env = f"\\necho '[gpuq] conda_env: {conda_env_name}' >> \"$LOG_FILE\""
    content = textwrap.dedent(
        f"""\
        #!/usr/bin/env bash
        set -u
        LOG_FILE={shlex.quote(str(log_path))}
        EXIT_FILE={shlex.quote(str(exit_path))}
        {{
          echo "[gpuq] started_at: $(date '+%F %T %z')"
          echo "[gpuq] job_id: {job['id']}"
          echo "[gpuq] cwd: {job['cwd']}"
          echo "[gpuq] gpus: {','.join(str(g) for g in job['gpus'])}"
          echo "[gpuq] command: {job['command']}"{echo_env}
        }} >> "$LOG_FILE"

        if ! cd {shlex.quote(job['cwd'])}; then
          rc=$?
          echo "[gpuq] cd failed: {job['cwd']}" >> "$LOG_FILE"
          printf '%s\\n' "$rc" > "$EXIT_FILE"
          exit "$rc"
        fi

        {conda_init}{conda_activate}{exports}bash -lc {shlex.quote(job['command'])} >> "$LOG_FILE" 2>&1
        rc=$?
        echo "[gpuq] finished_at: $(date '+%F %T %z')" >> "$LOG_FILE"
        echo "[gpuq] exit_code: $rc" >> "$LOG_FILE"
        printf '%s\\n' "$rc" > "$EXIT_FILE"
        exit "$rc"
        """
    )
    script_path.write_text(content, encoding="utf-8")
    script_path.chmod(script_path.stat().st_mode | stat.S_IXUSR)
    return script_path


def launch_job(job: dict[str, Any], config: dict[str, Any]) -> tuple[str, Path]:
    run_dir, log_path, exit_path = run_metadata_paths(job["id"])
    run_dir.mkdir(parents=True, exist_ok=False)
    wrapper = build_wrapper_script(job, run_dir, log_path, exit_path)
    session = f"{config['screen_prefix']}-{job['id']}-{slugify(job['name'])[:24]}"
    proc = run_command(["screen", "-dmS", session, config["shell"], str(wrapper)], check=False)
    if proc.returncode != 0:
        raise CliError(f"screen 启动失败: {proc.stderr.strip()}")
    job["status"] = "running"
    job["started_at"] = now_iso()
    job["finished_at"] = None
    job["screen_session"] = session
    job["run_dir"] = str(run_dir)
    job["log_path"] = str(log_path)
    job["exit_code"] = None
    job["hold_until"] = (now() + dt.timedelta(seconds=job["launch_hold_s"])).replace(microsecond=0).isoformat()
    time.sleep(1)
    if not screen_exists(session):
        job["status"] = "failed"
        job["finished_at"] = now_iso()
        job["exit_code"] = -1
        raise CliError(f"任务 {job['id']} 的 screen 会话未成功建立。")
    return session, log_path


def finish_running_job(job: dict[str, Any]) -> None:
    exit_code = None
    if job.get("run_dir"):
        exit_path = Path(job["run_dir"]) / "exit_code.txt"
        if exit_path.exists():
            try:
                exit_code = int(exit_path.read_text(encoding="utf-8").strip())
            except ValueError:
                exit_code = -1
    job["exit_code"] = exit_code
    job["finished_at"] = now_iso()
    job["hold_until"] = None
    job["status"] = "completed" if exit_code == 0 else "failed"


def daemon_log_path() -> Path:
    return LOG_DIR / "daemon.log"


def render_gpu_table(metrics: list[dict[str, Any]], gpu_filter: set[int] | None = None) -> str:
    rows = []
    for gpu in metrics:
        util = gpu["util"]
        idx = str(gpu["index"])
        mark = ""
        if gpu_filter and gpu["index"] in gpu_filter:
            mark = " ◀"
            idx = style(idx, "bright_cyan", bold=True)
        rows.append(
            [
                idx,
                gpu["name"],
                f"{render_gpu_bar(util)} {util}%",
                f"{gpu['mem_used']} / {gpu['mem_total']} MB",
            ]
        )
    return table(["GPU", "Name", "Util", "Memory"], rows)


def render_jobs(state: dict[str, Any], *, include_done: bool = False, queue: str | None = None) -> str:
    jobs = sorted(state["jobs"], key=job_sort_key)
    if queue is not None:
        jobs = [job for job in jobs if job.get("queue", "default") == queue]
    if not include_done:
        jobs = [job for job in jobs if job["status"] in {"queued", "running"}]
    if not jobs:
        return table(["ID", "P", "Queue", "Status", "Name", "GPUs", "Command"], [])

    term_w = get_term_width(120)
    rows = []
    for job in jobs:
        q = job.get("queue", "default")
        scheduled_info = ""
        sa = job.get("scheduled_after")
        if sa:
            t = parse_time(sa)
            if t and t > now():
                scheduled_info = f" ⏳{t.strftime('%m-%d %H:%M')}"
        rows.append(
            [
                str(job["id"]),
                priority_symbol(int(job.get("priority", 0))),
                q,
                f"{STATUS_STYLES.get(job['status'], {}).get('symbol', '?')} {STATUS_STYLES.get(job['status'], {}).get('label', job['status'])}",
                job["name"],
                ",".join(str(gpu) for gpu in job["gpus"]),
                shorten(job["command"], 80) + scheduled_info,
            ]
        )

    col_sep = 3
    fixed_cols = 6  # ID, P, Queue, Status, Name, GPUs
    id_w = max(2, max((len(r[0]) for r in rows), default=2))
    p_w = 1
    q_w = min(12, max((_cell_width(r[2]) for r in rows), default=5))
    st_w = max(6, max((_cell_width(r[3]) for r in rows), default=6))
    name_w = min(24, max((len(r[4]) for r in rows), default=4))
    gpu_w = min(20, max((len(r[5]) for r in rows), default=4))
    fixed_total = id_w + p_w + q_w + st_w + name_w + gpu_w + col_sep * fixed_cols + 2
    cmd_w = max(20, term_w - fixed_total)
    headers = ["ID", "P", "Queue", "Status", "Name", "GPUs", "Command"]
    widths = [id_w, p_w, q_w, st_w, name_w, gpu_w, cmd_w]

    styled_rows = []
    for i, r in enumerate(rows):
        cmd_text = shorten(r[6], cmd_w)
        j = jobs[i]
        styled_rows.append(
            [
                r[0],
                r[1],
                style(r[2], queue_color(r[2])),
                render_job_status(j["status"]),
                shorten(r[4], name_w),
                r[5],
                cmd_text,
            ]
        )

    # Build table manually to respect widths
    b = BOX
    sep_h, sep_v = b["h"], b["v"]
    tl, tr, bl, br = b["tl"], b["tr"], b["bl"], b["br"]
    ml, mr, mt, mb, x = b["ml"], b["mr"], b["mt"], b["mb"], b["x"]

    def _row(cells, left, mid, right, pad_char=" "):
        padded = [_pad(c, w) if pad_char == " " else pad_char * w for c, w in zip(cells, widths)]
        return left + mid.join(padded) + right

    lines = [
        _row([sep_h * w for w in widths], tl, mt, tr),
        _row(headers, sep_v, sep_v, sep_v),
        _row([sep_h * w for w in widths], ml, x, mr),
    ]
    for sr in styled_rows:
        lines.append(_row(sr, sep_v, sep_v, sep_v))
    lines.append(_row([sep_h * w for w in widths], bl, mb, br))
    return "\n".join(lines)


def render_job_detail(job: dict[str, Any]) -> str:
    q = job.get("queue", "default")
    p = job.get("priority", 0)
    sa = job.get("scheduled_after")
    sa_display = format_time(sa) if sa else "立即"
    ce = job.get("conda_env", "")
    lines = [
        f"ID:       {job['id']}",
        f"Name:     {job['name']}",
        f"Status:   {render_job_status(job['status'])}",
        f"Queue:    {style(q, queue_color(q))}",
        f"Priority: {priority_symbol(p)} {p}",
        f"Schedule: {sa_display}",
        f"Conda:    {ce if ce else '-'}",
        f"CWD:      {job['cwd']}",
        f"Command:  {job['command']}",
        f"GPUs:     {','.join(str(g) for g in job['gpus'])}",
        f"Created:  {format_time(job.get('created_at'))}",
        f"Started:  {format_time(job.get('started_at'))}",
        f"Finished: {format_time(job.get('finished_at'))}",
        f"Launch hold: {job.get('launch_hold_s')}s",
        f"Screen:   {job.get('screen_session') or '-'}",
        f"Log:      {job.get('log_path') or '-'}",
        f"Exit code: {job.get('exit_code') if job.get('exit_code') is not None else '-'}",
    ]
    return "\n".join(lines)


