def cmd_remove(args: argparse.Namespace) -> int:
    with state_lock():
        state = load_state()
        job = find_job(state, args.job_id)
        if job["status"] == "running":
            raise CliError("运行中的任务不能 remove，请先让它结束，或用 screen 手动停止。")
        if job["status"] not in {"queued", "failed", "completed", "canceled"}:
            raise CliError(f"当前状态不能 remove: {job['status']}")
        state["jobs"] = [item for item in state["jobs"] if item["id"] != args.job_id]
        save_state(state)
    print(f"已删除任务 {args.job_id}")
    return 0


def cmd_cancel(args: argparse.Namespace) -> int:
    with state_lock():
        state = load_state()
        job = find_job(state, args.job_id)
        if job["status"] == "running":
            if not args.force:
                raise CliError("运行中的任务需要加 --force 才会终止对应 screen。")
            session = job.get("screen_session")
            if session and screen_exists(session):
                run_command(["screen", "-S", session, "-X", "quit"], check=False)
            job["status"] = "canceled"
            job["finished_at"] = now_iso()
            job["hold_until"] = None
            job["exit_code"] = -15
        elif job["status"] == "queued":
            job["status"] = "canceled"
            job["finished_at"] = now_iso()
        else:
            raise CliError(f"当前状态不能 cancel: {job['status']}")
        save_state(state)
    print(f"已取消任务 {args.job_id}")
    return 0


def cmd_retry(args: argparse.Namespace) -> int:
    with state_lock():
        state = load_state()
        job = find_job(state, args.job_id)
        if job["status"] not in {"failed", "completed", "canceled"}:
            raise CliError(f"当前状态不能 retry: {job['status']}")
        job["status"] = "queued"
        job["started_at"] = None
        job["finished_at"] = None
        job["screen_session"] = None
        job["run_dir"] = None
        job["log_path"] = None
        job["exit_code"] = None
        job["hold_until"] = None
        job["scheduled_after"] = None
        job.setdefault("queue", "default")
        job.setdefault("priority", 0)
        save_state(state)
    print(f"已重新排队任务 {args.job_id}")
    return 0


def cmd_prioritize(args: argparse.Namespace) -> int:
    with state_lock():
        state = load_state()
        job = find_job(state, args.job_id)
        if job["status"] not in {"queued", "running", "failed", "completed", "canceled"}:
            raise CliError(f"当前状态不能修改优先级: {job['status']}")
        old = job.get("priority", 0)
        job["priority"] = args.priority
        save_state(state)
    print(f"任务 {args.job_id} 优先级: {old} → {args.priority}")
    return 0


def cmd_queues(_: argparse.Namespace) -> int:
    with state_lock():
        state = load_state()
    queues: dict[str, dict[str, int]] = {}
    for job in state["jobs"]:
        q = job.get("queue", "default")
        if q not in queues:
            queues[q] = {"total": 0, "queued": 0, "running": 0, "completed": 0, "failed": 0, "canceled": 0}
        queues[q]["total"] += 1
        st = job["status"]
        if st in queues[q]:
            queues[q][st] += 1
    if not queues:
        print("还没有任何队列。")
        return 0
    rows = []
    for qname in sorted(queues):
        qd = queues[qname]
        rows.append(
            [
                style(qname, queue_color(qname), bold=True),
                str(qd["total"]),
                f"{STATUS_STYLES['queued']['symbol']} {qd['queued']}",
                f"{STATUS_STYLES['running']['symbol']} {qd['running']}",
                f"{STATUS_STYLES['completed']['symbol']} {qd['completed']}",
                f"{STATUS_STYLES['failed']['symbol']} {qd['failed']}",
            ]
        )
    print(banner("队列概览"))
    print(table(["Queue", "Total", "Queued", "Running", "Done", "Failed"], rows))
    return 0


def cmd_logs(args: argparse.Namespace) -> int:
    with state_lock():
        state = load_state()
        job = find_job(state, args.job_id)
    if not job.get("log_path"):
        raise CliError("这个任务还没有日志文件。")
