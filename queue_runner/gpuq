class CliError(RuntimeError):
    pass


def ensure_layout() -> None:
    for path in (RUNTIME_DIR, LOG_DIR, RUN_DIR):
        path.mkdir(parents=True, exist_ok=True)
    if not CONFIG_FILE.exists():
        write_json(CONFIG_FILE, DEFAULT_CONFIG)
    if not STATE_FILE.exists():
        write_json(STATE_FILE, DEFAULT_STATE)
    LOCK_FILE.touch(exist_ok=True)


def read_json(path: Path, default: Any) -> Any:
    if not path.exists():
        return json.loads(json.dumps(default))
    with path.open("r", encoding="utf-8") as fh:
        return json.load(fh)


def write_json(path: Path, data: Any) -> None:
    tmp = path.with_name(f"{path.name}.{os.getpid()}.{time.time_ns()}.tmp")
    with tmp.open("w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2, ensure_ascii=False)
        fh.write("\n")
    os.replace(tmp, path)


@contextlib.contextmanager
def state_lock(timeout: float | None = None):
    ensure_layout()
    with LOCK_FILE.open("a+", encoding="utf-8") as fh:
        fd = fh.fileno()
        if timeout is not None:
            deadline = time.time() + timeout
            while True:
                try:
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except (BlockingIOError, OSError):
                    if time.time() >= deadline:
                        raise CliError("状态文件被锁定，请稍后重试（守护进程可能正在操作）")
                    time.sleep(0.1)
        else:
            fcntl.flock(fd, fcntl.LOCK_EX)
        yield


def migrate_job(job: dict[str, Any]) -> None:
    job.setdefault("priority", 0)
    job.setdefault("queue", "default")
    job.setdefault("scheduled_after", None)
    job.setdefault("conda_env", "")


def load_state() -> dict[str, Any]:
    state = read_json(STATE_FILE, DEFAULT_STATE)
    if "jobs" not in state:
        state["jobs"] = []
    if "next_job_id" not in state:
        state["next_job_id"] = 1
    for job in state["jobs"]:
        migrate_job(job)
    return state


def save_state(state: dict[str, Any]) -> None:
    write_json(STATE_FILE, state)


def load_config() -> dict[str, Any]:
    config = DEFAULT_CONFIG.copy()
    config.update(read_json(CONFIG_FILE, {}))
    return config


def save_config(config: dict[str, Any]) -> None:
    write_json(CONFIG_FILE, config)


def now() -> dt.datetime:
    return dt.datetime.now().astimezone()


def now_iso() -> str:
    return now().replace(microsecond=0).isoformat()


def parse_time(value: str | None) -> dt.datetime | None:
    if not value:
        return None
    return dt.datetime.fromisoformat(value)


def format_time(value: str | None) -> str:
    if not value:
        return "-"
    try:
        ts = parse_time(value)
        assert ts is not None
        return ts.strftime("%Y-%m-%d %H:%M:%S")
    except Exception:
        return value


def format_duration(seconds: float | int | None) -> str:
    if seconds is None:
        return "-"
    total = int(max(0, seconds))
    hours, rem = divmod(total, 3600)
    minutes, secs = divmod(rem, 60)
    if hours:
        return f"{hours}h{minutes:02d}m{secs:02d}s"
    if minutes:
        return f"{minutes}m{secs:02d}s"
    return f"{secs}s"


def is_tty() -> bool:
    return sys.stdout.isatty()


def style(text: str, color: str | None = None, bold: bool = False, dim: bool = False) -> str:
    if not is_tty() or not color:
        return text
    codes: dict[str, str] = {
        "red": "31",
        "green": "32",
        "yellow": "33",
        "blue": "34",
        "magenta": "35",
        "cyan": "36",
        "white": "37",
        "gray": "90",
        "bright_red": "91",
        "bright_green": "92",
        "bright_yellow": "93",
        "bright_blue": "94",
        "bright_magenta": "95",
        "bright_cyan": "96",
    }
    parts: list[str] = []
    if bold:
        parts.append("1")
    if dim:
        parts.append("2")
    parts.append(codes[color])
    return f"\033[{';'.join(parts)}m{text}\033[0m"


def banner(title: str) -> str:
    return style(title, "blue", bold=True)


def clear_screen() -> None:
    if is_tty():
        print("\033[2J\033[H", end="")


def shell_join(parts: list[str]) -> str:
    return " ".join(shlex.quote(part) for part in parts)


def run_command(parts: list[str], check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(parts, text=True, capture_output=True, check=check)


def require_binary(name: str) -> str:
    path = shutil.which(name)
    if not path:
        raise CliError(f"找不到依赖命令: {name}")
    return path


def slugify(value: str, fallback: str = "job") -> str:
    slug = re.sub(r"[^a-zA-Z0-9._-]+", "-", value).strip("-_.")
    return slug or fallback


def get_term_width(fallback: int = 120) -> int:
    try:
        return os.get_terminal_size().columns
    except (OSError, ValueError):
        return fallback


def shorten(text: str, width: int) -> str:
    if width <= 0:
        return ""
    if _cell_width(text) <= width:
        return text
    if width <= 1:
        return text[:width]
    return text[: width - 1] + "…"


def prompt(label: str, default: str | None = None, allow_empty: bool = False) -> str:
    if not is_tty():
        if default is not None:
            return default
        if allow_empty:
            return ""
        raise CliError(f"非交互模式需要提供完整参数，缺少: {label}")
    while True:
        suffix = f" [{default}]" if default not in (None, "") else ""
        raw = input(f"{label}{suffix}: ").strip()
        if raw:
            return raw
        if default is not None:
            return default
        if allow_empty:
            return ""
        print("这个字段不能为空。")


def parse_schedule(raw: str) -> str | None:
    """Parse schedule string: absolute datetime, +2h, +30m, or empty for immediate."""
    text = raw.strip()
    if not text:
        return None
    if text.startswith("+"):
        total_s = 0
        for m in re.finditer(r"(\d+)\s*(h|m|s)", text[1:], re.IGNORECASE):
            val = int(m.group(1))
            unit = m.group(2).lower()
            if unit == "h":
                total_s += val * 3600
            elif unit == "m":
                total_s += val * 60
            else:
                total_s += val
        if total_s > 0:
            return (now() + dt.timedelta(seconds=total_s)).replace(microsecond=0).isoformat()
    try:
        ts = dt.datetime.fromisoformat(text)
        return ts.isoformat()
    except ValueError:
        pass
    try:
        ts = dt.datetime.strptime(text, "%Y-%m-%d %H:%M")
        return ts.astimezone().isoformat()
    except ValueError:
        pass
    try:
        ts = dt.datetime.strptime(text, "%Y-%m-%d %H:%M:%S")
        return ts.astimezone().isoformat()
    except ValueError:
        pass
    raise CliError(f"无法解析时间: {text}（支持: 2026-05-01 08:00, +2h, +30m, +1h30m）")


