    daemon_p = sub.add_parser("daemon", help="后台守护进程管理")
    daemon_sub = daemon_p.add_subparsers(dest="daemon_cmd", required=True)

    daemon_start_p = daemon_sub.add_parser("start", help="启动后台守护进程")
