    config_set_p.set_defaults(func=cmd_config_set)

    config_reset_p = config_sub.add_parser("reset", help="恢复默认配置")
    config_reset_p.set_defaults(func=cmd_config_reset)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    try:
        require_binary("screen")
    except CliError as exc:
        print(f"错误: {exc}", file=sys.stderr)
        return 2
    if args.command is None:
        try:
            Dashboard().run()
        except CliError as exc:
            print(f"错误: {exc}", file=sys.stderr)
            return 2
        except KeyboardInterrupt:
            print()
        return 0
    try:
        return int(args.func(args))
    except CliError as exc:
        print(f"错误: {exc}", file=sys.stderr)
        return 2
    except subprocess.CalledProcessError as exc:
        message = exc.stderr.strip() or exc.stdout.strip() or str(exc)
        print(f"命令执行失败: {message}", file=sys.stderr)
        return 3


if __name__ == "__main__":
    raise SystemExit(main())
