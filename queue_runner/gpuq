    job = {
        "id": job_id,
        "name": name,
        "queue": queue if queue is not None else str(config.get("default_queue", "default")),
        "priority": int(priority if priority is not None else config.get("default_priority", 0)),
        "scheduled_after": scheduled_after,
        "conda_env": conda_env if conda_env is not None else str(config.get("default_conda_env", "")),
        "cwd": str(Path(cwd).expanduser().resolve()),
        "command": command,
        "gpus": gpus,
        "status": "queued",
        "created_at": now_iso(),
        "started_at": None,
        "finished_at": None,
        "screen_session": None,
        "run_dir": None,
        "log_path": None,
        "exit_code": None,
        "launch_hold_s": int(launch_hold_s if launch_hold_s is not None else config["launch_hold_s"]),
        "idle_util_threshold": int(
            idle_util_threshold if idle_util_threshold is not None else config["idle_util_threshold"]
        ),
        "idle_mem_threshold_mb": int(
            idle_mem_threshold_mb if idle_mem_threshold_mb is not None else config["idle_mem_threshold_mb"]
        ),
        "idle_streak_required": int(
            idle_streak_required if idle_streak_required is not None else config["idle_streak_required"]
        ),
        "set_cuda_visible_devices": (
            set_cuda_visible_devices
            if set_cuda_visible_devices is not None
            else bool(config["set_cuda_visible_devices"])
        ),
        "notes": [],
    }
