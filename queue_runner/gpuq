    """ANSI-based multi-field form for job creation."""

    def __init__(self, defaults: dict[str, Any], metrics: list[dict[str, Any]]):
        self.defaults = defaults
        self.metrics = metrics
        self.fields: list[dict[str, Any]] = [
            {
                "key": "name",
                "label": "任务名",
                "value": defaults.get("name", ""),
                "hint": "任务描述名称",
                "required": True,
            },
            {
                "key": "queue",
                "label": "队列",
                "value": defaults.get("queue", "default"),
                "hint": "队列名，用于分组管理",
                "required": False,
            },
            {
                "key": "command",
                "label": "运行命令",
                "value": defaults.get("command", ""),
                "hint": "要执行的 shell 命令或脚本",
                "required": True,
            },
            {
                "key": "conda_env",
                "label": "Conda 环境",
                "value": defaults.get("conda_env", ""),
                "hint": "Conda 环境名，留空不激活（会自动 source conda.sh）",
                "required": False,
            },
            {
                "key": "cwd",
                "label": "工作目录",
                "value": defaults.get("cwd", ""),
                "hint": "命令执行时的工作目录",
                "required": True,
            },
            {
                "key": "gpus",
                "label": "GPU 列表",
                "value": defaults.get("gpus", ""),
                "hint": "逗号分隔，如 0,1,2；留空=全部",
                "required": False,
            },
            {
                "key": "priority",
                "label": "优先级",
                "value": str(defaults.get("priority", 0)),
                "hint": "数字越大越优先，0=默认",
                "required": False,
            },
            {
                "key": "schedule",
                "label": "定时启动",
                "value": defaults.get("schedule", ""),
                "hint": "留空=立即；支持 +2h, +30m, 2026-05-01 08:00",
                "required": False,
            },
            {
                "key": "launch_hold_s",
                "label": "启动保护(s)",
                "value": str(defaults.get("launch_hold_s", "")),
                "hint": "任务启动后保护时间，留空用默认",
                "required": False,
            },
        ]
        self._cursor = 0
        self._editing = -1
        self._edit_buf = ""
        self._message = ""
        self._submitted = False

    def _move_cursor(self, delta: int) -> None:
        self._cursor = max(0, min(len(self.fields) - 1, self._cursor + delta))

    def _render(self) -> str:
        lines: list[str] = []
        lines.append(clear_screen_raw())
        lines.append(banner("╔══════════════════════════════════════╗"))
        lines.append(banner("║         GPU Queue - 添加任务          ║"))
        lines.append(banner("╚══════════════════════════════════════╝"))
        lines.append("")
        lines.append(style("  ↑↓ 选择字段  Enter 编辑  Tab 提交  Esc 取消", "gray"))
        lines.append("")

        for i, field in enumerate(self.fields):
            cursor = style(">", "bright_cyan", bold=True) if i == self._cursor else " "
            label = field["label"]
            key = field["key"]
            val = field["value"]

            if i == self._editing:
                display_val = self._edit_buf + style("█", "bright_cyan")
            elif val:
                if key == "priority":
                    p = int(val) if val.lstrip("-").isdigit() else 0
                    display_val = f"{priority_symbol(p)} {val}"
                elif key == "queue":
                    display_val = style(val, queue_color(val))
                elif key == "schedule":
                    display_val = style(val, "bright_yellow") if val else style("立即", "gray", dim=True)
                elif key == "gpus":
                    display_val = style(val, "bright_cyan") if val else style("全部 GPU", "gray", dim=True)
                else:
                    display_val = val
            else:
                display_val = style("(未设置)", "gray", dim=True)

            hint = style(f"  ← {field['hint']}", "gray") if not display_val or display_val == style("(未设置)", "gray", dim=True) else ""
            lines.append(f"   {cursor} {style(label + ':', 'white', bold=True):<18} {display_val}{hint}")

        lines.append("")
        if self._message:
            lines.append(f"  {self._message}")
        lines.append("")
        lines.append(style("  ─────────────────────────────────────", "gray"))
        # GPU reference
        if self.metrics:
            lines.append(style("  可用 GPU:", "gray"))
            for gpu in self.metrics:
                lines.append(
                    style(
                        f"    GPU {gpu['index']}: {gpu['name']}  {render_gpu_bar(gpu['util'])} {gpu['util']}%  {gpu['mem_used']}/{gpu['mem_total']} MB",
                        "gray",
                    )
                )
        return "\r\n".join(lines)

    def _edit_field(self, idx: int) -> None:
        field = self.fields[idx]
        self._editing = idx
        self._edit_buf = field["value"]
        self._message = style("输入新值，Enter 确认，Esc 取消", "bright_yellow")

    def _commit_edit(self) -> None:
        if self._editing < 0:
            return
        field = self.fields[self._editing]
        val = self._edit_buf.strip()
        if field.get("required") and not val:
            self._message = style(f"{field['label']} 不能为空", "red")
            return
        field["value"] = val
        self._editing = -1
        self._edit_buf = ""
        self._message = ""

    def _cancel_edit(self) -> None:
        self._editing = -1
        self._edit_buf = ""
        self._message = ""

    def _submit(self) -> dict[str, str]:
        missing = []
        for f in self.fields:
            if f.get("required") and not f["value"].strip():
                missing.append(f["label"])
        if missing:
            self._message = style(f"必填字段未填: {', '.join(missing)}", "red")
            return {}
        self._submitted = True
        return {f["key"]: f["value"] for f in self.fields}

    def run(self, already_raw: bool = False) -> dict[str, str] | None:
        if not is_tty():
            return None
        try:
            import termios
            import tty
        except ImportError:
            return None

        fd = sys.stdin.fileno()
        old_settings = None if already_raw else termios.tcgetattr(fd)
        try:
            if not already_raw:
                tty.setraw(fd)
            sys.stdout.write(enter_alt_screen())
            sys.stdout.write(hide_cursor())
            sys.stdout.flush()
            self._run_raw()
        finally:
            sys.stdout.write(leave_alt_screen())
            sys.stdout.write(show_cursor())
            sys.stdout.flush()
            if not already_raw and old_settings is not None:
                termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
            if not already_raw:
                print()

        if self._submitted:
            return {f["key"]: f["value"] for f in self.fields}
        return None

    def _run_raw(self) -> None:
        while not self._submitted:
            self._redraw()
            ch = _read_keyboard(0.10)
            if not ch:
                continue

            if self._editing >= 0:
                self._handle_edit_key(ch)
            else:
                self._handle_nav_key(ch)

    def _handle_nav_key(self, ch: str) -> None:
        if ch in ("\x1b", "q"):
            self._submitted = False
            return
        elif ch == "\t":
            self._submit()
        elif ch in ("\r", "\n"):
            self._edit_field(self._cursor)
        elif ch == "\x1b[A":
            self._move_cursor(-1)
        elif ch == "\x1b[B":
            self._move_cursor(1)
        elif ch == "\x03":
            self._submitted = False
            return

    def _handle_edit_key(self, ch: str) -> None:
        if ch == "\x1b":
            self._cancel_edit()
        elif ch in ("\r", "\n"):
            self._commit_edit()
        elif ch == "\x7f":
            self._edit_buf = self._edit_buf[:-1]
        elif ch == "\x03":
            self._cancel_edit()
        elif len(ch) == 1 and ord(ch) >= 32:
            self._edit_buf += ch

    def _redraw(self) -> None:
        sys.stdout.write(clear_screen_raw() + self._render())
        sys.stdout.flush()


def clear_screen_raw() -> str:
    return "\033[H\033[J"


def enter_alt_screen() -> str:
    return "\033[?1049h"


def leave_alt_screen() -> str:
    return "\033[?1049l"


def show_cursor() -> str:
    return "\033[?25h"


def hide_cursor() -> str:
    return "\033[?25l"


# ── shared raw terminal input ─────────────────────────────────


def _read_raw_input(timeout: float = 0.05) -> str:
    """Read a complete input sequence from stdin in raw mode.

    Handles plain keys, escape sequences (arrows, etc.), and Ctrl+key combos.
    Uses select on the raw fd for portability.
    Returns '' on timeout, single char for plain keys, or full escape sequence.
    """
    import os as _os
    import select as _sel

    fd = sys.stdin.fileno()
    r, _, _ = _sel.select([fd], [], [], timeout)
    if not r:
        return ""
    # Read first byte
    data = _os.read(fd, 1)
    if not data:
        return ""
    first = data.decode("latin-1")
    if first != "\x1b":
        return first
    # Escape sequence — buffer remaining bytes with a longer timeout
    buf = "\x1b"
    deadline = time.time() + 0.10
    while time.time() < deadline:
        r2, _, _ = _sel.select([fd], [], [], max(0, deadline - time.time()))
        if not r2:
            break
        data = _os.read(fd, 1)
        if not data:
            break
        buf += data.decode("latin-1")
        # Common escape sequences are 2-6 bytes; stop when we have enough
        if len(buf) >= 6:
            break
    return buf


def _read_keyboard(timeout: float = 0.08) -> str:
    """Shorthand wrapper used by both Dashboard and form."""
    return _read_raw_input(timeout)


class Dashboard:
    """Full-screen interactive TUI like top/htop for GPU queue management."""

    def __init__(self) -> None:
        self._quit = False
        self._jobs: list[dict[str, Any]] = []
        self._metrics: list[dict[str, Any]] = []
        self._config: dict[str, Any] = {}
        self._cursor = 0
        self._scroll = 0
        self._message = ""
        self._modal: str | None = None
        self._modal_data: Any = None
        self._sort_mode = "priority"
        self._filter_queue: str | None = None
        self._refresh_interval = 2.0

    # ── raw terminal helpers ──────────────────────────────────────

    def _enter_raw(self) -> Any:
        import termios
        import tty

        fd = sys.stdin.fileno()
        old = termios.tcgetattr(fd)
        tty.setraw(fd)
        return old

    def _leave_raw(self, old: Any) -> None:
        import termios

        fd = sys.stdin.fileno()
        termios.tcsetattr(fd, termios.TCSADRAIN, old)

    # ── data loading ──────────────────────────────────────────────

    def _reload(self) -> None:
        try:
            self._metrics = load_gpu_metrics()
        except Exception:
            pass
        try:
            with state_lock(timeout=1.0):
                self._config = load_config()
                state = load_state()
                jobs = sorted(state["jobs"], key=job_sort_key)
                if self._filter_queue:
                    jobs = [j for j in jobs if j.get("queue", "default") == self._filter_queue]
                self._jobs = jobs
        except CliError:
            pass  # lock busy, keep old data
        self._clamp_cursor()

    def _clamp_cursor(self) -> None:
        max_idx = max(0, len(self._jobs) - 1)
        self._cursor = max(0, min(self._cursor, max_idx))

    def _open_modal(self, kind: str, data: Any = None) -> None:
        self._modal = kind
        self._modal_data = data

    def _render_modal(self) -> list[str]:
        lines: list[str] = []
        term_w = get_term_width(80)
        mw = max(40, min(term_w - 4, 72))
        b = BOX
        sep_h = b["h"]

        def _box(title: str, content: list[str]) -> list[str]:
            inner = mw - 2
            box_lines = [
                b["tl"] + sep_h * inner + b["tr"],
                b["v"] + style(title.center(inner), "white", bold=True) + b["v"],
                b["ml"] + sep_h * inner + b["mr"],
            ]
            for cl in content:
                for sub in cl.split("\n"):
                    box_lines.append(b["v"] + " " + _pad(sub, inner - 1) + b["v"])
            box_lines.append(b["bl"] + sep_h * inner + b["br"])
            return box_lines

        if self._modal == "help":
            lines.extend(
                _box(
                    "帮助",
                    [
                        style("a", "bright_cyan") + "  添加任务       " + style("c", "bright_cyan") + "  取消任务",
                        style("r", "bright_cyan") + "  重试任务       " + style("p", "bright_cyan") + "  修改优先级",
                        style("d", "bright_cyan") + "  启停守护进程   " + style("f", "bright_cyan") + "  切换队列筛选",
                        style("s", "bright_cyan") + "  切换排序       " + style("l", "bright_cyan") + "  查看日志",
                        style("Enter", "bright_cyan") + " 查看详情     " + style("↑↓", "bright_cyan") + " 导航",
                        style("q", "bright_cyan") + "  退出           " + style("Esc", "bright_cyan") + " 关闭弹窗",
                        "",
                        style("按任意键返回", "gray"),
                    ],
                )
            )
        elif self._modal == "detail":
            job = self._modal_data
            if job:
                lines.extend(_box(f"Job {job['id']}", render_job_detail(job).split("\n")))
                lines.extend([style("  Esc 关闭  c 取消  x 删除  r 重试  l 日志  p 改优先级", "gray")])
        elif self._modal == "confirm":
            msg, action = self._modal_data
            lines.extend(_box("确认", [msg, "", style("y/Enter 确认  n/Esc 取消", "bright_yellow")]))
        elif self._modal == "input":
            prompt_text, callback_key = self._modal_data
            buf_display = getattr(self, "_input_buf", "")
            lines.extend(_box("输入", [
                prompt_text,
                "",
                style(f"> {buf_display}" + ("█" if buf_display or True else ""), "bright_cyan", bold=True),
                "",
                style("Enter 确认  Esc 取消", "gray"),
            ]))

        return lines

    # ── key handling ──────────────────────────────────────────────

    def _read_key(self, timeout: float = 0.1) -> str:
        return _read_keyboard(timeout)

    def _handle_key(self, key: str) -> bool:
        if self._modal:
            return self._handle_modal_key(key)

        if key in ("q", "\x1b"):
            self._quit = True
            return True
        elif key == "\x1b[A" or key == "k":
            self._cursor = max(0, self._cursor - 1)
            if self._cursor < self._scroll:
                self._scroll = self._cursor
        elif key == "\x1b[B" or key == "j":
            self._cursor = min(len(self._jobs) - 1, self._cursor + 1) if self._jobs else 0
            visible_h = max(10, os.get_terminal_size().lines - 24 if is_tty() else 20)
            if self._cursor >= self._scroll + visible_h:
                self._scroll = self._cursor - visible_h + 1
        elif key == "a":
            self._do_add()
        elif key == "c":
            self._do_cancel()
        elif key == "x":
            self._do_remove()
        elif key == "r":
            self._do_retry()
        elif key == "p":
            self._do_prioritize()
        elif key == "d":
            self._do_daemon_toggle()
        elif key == "f":
            self._do_filter()
        elif key == "s":
            self._do_sort_cycle()
        elif key == "l":
            self._do_logs()
        elif key in ("\r", "\n"):
            self._do_detail()
        elif key == "?":
            self._modal = "help"
        elif key == "\x03":
            self._quit = True
            return True
        self._message = ""
        return False

    def _handle_modal_key(self, key: str) -> bool:
        # Esc always closes any modal (except input where it cancels edit)
        if key == "\x1b" and self._modal not in ("input",):
            self._modal = None
            return False

        if self._modal == "help":
            if key and not key.startswith("\x1b["):
                self._modal = None
        elif self._modal == "detail":
            if key == "q":
                self._modal = None
            elif key == "c":
                self._modal = None
                self._do_cancel()
            elif key == "x":
                self._modal = None
                self._do_remove()
            elif key == "r":
                self._modal = None
                self._do_retry()
            elif key == "p":
                self._modal = None
                self._do_prioritize()
            elif key == "l":
                self._modal = None
                self._do_logs()
        elif self._modal == "confirm":
            if key in ("y", "\r", "\n"):
                _, action = self._modal_data
                self._modal = None
                action()
            elif key == "n":
                self._modal = None
        elif self._modal == "input":
            if key == "\x1b":
                self._modal = None
            elif key in ("\r", "\n"):
                _, callback = self._modal_data
                self._modal = None
                callback()
            elif key == "\x7f":
                self._input_buf = self._input_buf[:-1]
            elif len(key) == 1 and ord(key) >= 32:
                self._input_buf += key
        return False

    # ── actions ───────────────────────────────────────────────────

    def _do_add(self) -> None:
        self._message = ""
        try:
            metrics = load_gpu_metrics()
            form = InteractiveForm(
                {
                    "name": "",
                    "queue": self._filter_queue or self._config.get("default_queue", "default"),
                    "command": "",
                    "cwd": str(BASE_DIR),
                    "gpus": "",
                    "priority": self._config.get("default_priority", 0),
                    "schedule": "",
                    "launch_hold_s": str(self._config.get("launch_hold_s", "")),
                },
                metrics,
            )
            result = form.run(already_raw=True)
            if result is None:
                result = fallback_add_form(self._config, metrics, argparse.Namespace(
                    name=None, command=None, cwd=None, gpus=None,
                    queue=self._filter_queue, priority=None, schedule_at=None,
                    launch_hold_s=None,
                ))
            if result:
                launch_hold_raw = (result.get("launch_hold_s") or "").strip()
                args = argparse.Namespace(
                    name=result.get("name"),
                    command=result.get("command"),
                    cwd=result.get("cwd"),
                    gpus=result.get("gpus"),
                    queue=result.get("queue"),
                    priority=int(result.get("priority", 0)) if result.get("priority") else None,
                    schedule_at=result.get("schedule"),
                    conda_env=result.get("conda_env"),
                    launch_hold_s=int(launch_hold_raw) if launch_hold_raw else None,
                    idle_util_threshold=None,
                    idle_mem_threshold_mb=None,
                    idle_streak_required=None,
                    set_cuda_visible_devices=None,
                )
                cmd_add(args)
                self._message = style("任务已添加", "green")
        except Exception as e:
            self._message = style(f"添加失败: {e}", "red")

    def _do_cancel(self) -> None:
        try:
            if not self._jobs or self._cursor >= len(self._jobs):
                return
            job = self._jobs[self._cursor]
            if job["status"] not in ("queued", "running"):
                self._message = style("只能取消 queued/running 任务", "red")
                return
            def _force_cancel():
                try:
                    args = argparse.Namespace(job_id=job["id"], force=True)
                    cmd_cancel(args)
                    self._message = style(f"已取消任务 {job['id']}", "green")
                except CliError as e:
                    self._message = style(str(e), "red")
            if job["status"] == "running":
                self._open_modal("confirm", (f"强制取消运行中的任务 {job['id']} ({job['name']})?", _force_cancel))
            else:
                args = argparse.Namespace(job_id=job["id"], force=False)
                cmd_cancel(args)
                self._message = style(f"已取消任务 {job['id']}", "green")
        except CliError as e:
            self._message = style(str(e), "red")

    def _do_remove(self) -> None:
        try:
            if not self._jobs or self._cursor >= len(self._jobs):
                return
            job = self._jobs[self._cursor]
            if job["status"] == "running":
                self._message = style("运行中的任务不能删除，请先 cancel", "red")
                return
            def _force_remove():
                try:
                    args = argparse.Namespace(job_id=job["id"])
                    cmd_remove(args)
                    self._message = style(f"已删除任务 {job['id']}", "green")
                except CliError as e:
                    self._message = style(str(e), "red")
            self._open_modal("confirm", (f"删除任务 {job['id']} ({job['name']})?", _force_remove))
        except CliError as e:
            self._message = style(str(e), "red")

    def _do_retry(self) -> None:
        if not self._jobs or self._cursor >= len(self._jobs):
            return
        job = self._jobs[self._cursor]
        if job["status"] not in ("failed", "completed", "canceled"):
            self._message = style("只能重试已结束的任务", "red")
            return
        try:
            args = argparse.Namespace(job_id=job["id"])
            cmd_retry(args)
            self._message = style(f"任务 {job['id']} 已重新排队", "green")
        except CliError as e:
            self._message = style(str(e), "red")

    def _do_prioritize(self) -> None:
        if not self._jobs or self._cursor >= len(self._jobs):
            return
        job = self._jobs[self._cursor]
        def _set_prio():
            try:
                new_p = int(self._input_buf)
                args = argparse.Namespace(job_id=job["id"], priority=new_p)
                cmd_prioritize(args)
                self._message = style(f"优先级已更新", "green")
            except (ValueError, CliError) as e:
                self._message = style(str(e), "red")
        self._input_buf = str(job.get("priority", 0))
        def _commit_prio():
            _set_prio()
        self._open_modal("input", (f"任务 {job['id']} 新优先级:", _commit_prio))

    def _do_daemon_toggle(self) -> None:
        daemon_session = self._config.get("daemon_session_name", "gpuq-daemon")
        if screen_exists(daemon_session):
            cmd_daemon_stop(argparse.Namespace())
            self._message = style("守护进程已停止", "yellow")
        else:
            cmd_daemon_start(argparse.Namespace())
            self._message = style("守护进程已启动", "green")

    def _do_filter(self) -> None:
        with state_lock():
            state = load_state()
        all_queues = sorted({j.get("queue", "default") for j in state["jobs"]})
        if not all_queues:
            all_queues = ["default"]
        try:
            idx = all_queues.index(self._filter_queue) if self._filter_queue in all_queues else -1
            idx = (idx + 1) % (len(all_queues) + 1)
            self._filter_queue = all_queues[idx] if idx < len(all_queues) else None
        except ValueError:
            self._filter_queue = None

    def _do_sort_cycle(self) -> None:
        modes = ["priority", "id", "status"]
        try:
            idx = modes.index(self._sort_mode)
        except ValueError:
            idx = 0
        self._sort_mode = modes[(idx + 1) % len(modes)]
        global job_sort_key
        if self._sort_mode == "id":

            def _by_id(j: dict[str, Any]) -> tuple[int, int]:
                return (0, int(j["id"]))

            job_sort_key = _by_id
        elif self._sort_mode == "status":
            status_order = {"running": 0, "queued": 1, "completed": 2, "failed": 3, "canceled": 4}

            def _by_status(j: dict[str, Any]) -> tuple[int, int]:
                return (status_order.get(j["status"], 9), int(j["id"]))

            job_sort_key = _by_status
        else:

            def _by_priority(j: dict[str, Any]) -> tuple[int, int]:
                return (-int(j.get("priority", 0)), int(j["id"]))

            job_sort_key = _by_priority

    def _do_logs(self) -> None:
        if not self._jobs or self._cursor >= len(self._jobs):
            return
        job = self._jobs[self._cursor]
        if not job.get("log_path"):
            self._message = style("该任务还没有日志", "yellow")
            return
        log_path = Path(job["log_path"])
        if not log_path.exists():
            self._message = style("日志文件不存在", "yellow")
            return
        self._leave_raw(self._old_term)
        print(clear_screen_raw(), end="", flush=True)
        print(style(f"Log: {log_path}", "bright_cyan", bold=True))
        print(style("─" * 60, "gray"))
        with log_path.open("r", encoding="utf-8", errors="replace") as fh:
            lines_list = fh.readlines()
        for line in lines_list[-40:]:
            print(line.rstrip("\n"))
        print()
        print(style("按任意键返回...", "gray"))
        import select

        select.select([sys.stdin], [], [], 300)
        self._old_term = self._enter_raw()

    def _do_detail(self) -> None:
        if not self._jobs or self._cursor >= len(self._jobs):
            return
        self._open_modal("detail", self._jobs[self._cursor])

    # ── main loop ─────────────────────────────────────────────────

    def run(self) -> None:
        if not is_tty():
            print(style("Dashboard 仅在交互终端可用，请使用子命令。", "yellow"))
            return

        self._old_term = self._enter_raw()
        try:
            # Enter alternate screen buffer (like top/less/vim)
            sys.stdout.write(enter_alt_screen())
            sys.stdout.write(clear_screen_raw())
            sys.stdout.write(hide_cursor())
            sys.stdout.flush()

            self._reload()
            last_refresh = 0.0
            while not self._quit:
                now_ts = time.time()
                if now_ts - last_refresh >= self._refresh_interval:
                    self._reload()
                    last_refresh = now_ts

                sys.stdout.write(clear_screen_raw() + self._render_body())
                sys.stdout.flush()

                # Read input with short timeout for responsiveness
                key = self._read_key(timeout=0.08)
                if key:
                    if self._handle_key(key):
                        break
                    self._reload()
                    last_refresh = time.time()
        finally:
            sys.stdout.write(leave_alt_screen())
            sys.stdout.write(show_cursor())
            sys.stdout.flush()
            self._leave_raw(self._old_term)
            print()

    def _render_body(self) -> str:
        """Render body content (without clear screen, for use with separate clear)."""
        term_w = get_term_width(80)
        term_h = os.get_terminal_size().lines if is_tty() else 40
        out: list[str] = []

        # Header — full terminal width
        daemon_session = self._config.get("daemon_session_name", "gpuq-daemon")
        daemon_running = screen_exists(daemon_session)
        daemon_str = style("● running", "green") if daemon_running else style("○ stopped", "gray")
        queue_label = f" [{self._filter_queue}]" if self._filter_queue else ""
        title = f"GPU Queue{queue_label}"
        inner_w = max(40, term_w - 2)
        out.append(
            style("╔" + "═" * inner_w + "╗", "bright_blue", bold=True)
        )
        left = f" {style(title, 'white', bold=True)}"
        right = f"daemon: {daemon_str} "
        pad = inner_w - _cell_width(left) - _cell_width(right) - 1
        pad = max(1, pad)
        out.append(
            style("║", "bright_blue", bold=True)
            + left
            + " " * pad
            + right
            + style("║", "bright_blue", bold=True)
        )
        out.append(style("╚" + "═" * inner_w + "╝", "bright_blue", bold=True))
        out.append("")

        # GPU panel — compact, don't fill excess width
        if self._metrics:
            id_w = 3
            name_w = 24
            util_w = 18
            mem_min = 16
            gpu_w = id_w + name_w + util_w + mem_min + 11  # 11 = 3 separators + 2 borders
            gpu_w = min(gpu_w, term_w - 2)
            extra = max(0, term_w - 2 - gpu_w)
            mem_w = mem_min + extra
            gpu_rows = []
            for gpu in self._metrics:
                util = gpu["util"]
                idx = str(gpu["index"])
                mem_str = f"{gpu['mem_used']}/{gpu['mem_total']}"
                gpu_rows.append([idx, gpu["name"], f"{render_gpu_bar(util)} {util}%", f"{mem_str} MB"])
            b = BOX
            sep_h = b["h"]
            gpu_hdrs = ["GPU", "Name", "Util", "Memory"]
            gpu_widths = [id_w, name_w, util_w, mem_w]
            out.append(style("▸ GPU", "bright_blue", bold=True))
            out.append(b["tl"] + b["mt"].join(sep_h * w for w in gpu_widths) + b["tr"])
            out.append(b["v"] + b["v"].join(_pad(h, w) for h, w in zip(gpu_hdrs, gpu_widths)) + b["v"])
            out.append(b["ml"] + b["x"].join(sep_h * w for w in gpu_widths) + b["mr"])
            for gr in gpu_rows:
                out.append(b["v"] + b["v"].join(_pad(c, w) for c, w in zip(gr, gpu_widths)) + b["v"])
            out.append(b["bl"] + b["mb"].join(sep_h * w for w in gpu_widths) + b["br"])
        out.append("")

        # Job list
        out.append(style("▸ Jobs", "bright_blue", bold=True))
        out.append(f"  {render_summary_simple()}")
        if self._filter_queue:
            out.append(f"  filter: {style(self._filter_queue, queue_color(self._filter_queue))}  (f 切换)")
        out.append("")

        if self._jobs:
            overhead = self._count_overhead(out) + 8
            visible_h = max(4, term_h - overhead)
            max_display = min(len(self._jobs), visible_h)
            if self._scroll + max_display > len(self._jobs):
                self._scroll = max(0, len(self._jobs) - max_display)
            display_jobs = self._jobs[self._scroll : self._scroll + max_display]

            id_w = max(2, max((len(str(j["id"])) for j in display_jobs), default=2)) + 1
            p_w = 1
            q_w = min(10, max((_cell_width(j.get("queue", "default")) for j in display_jobs), default=5))
            st_w = max(6, max(
                (_cell_width(f"{STATUS_STYLES.get(j['status'], {}).get('symbol', '?')} {STATUS_STYLES.get(j['status'], {}).get('label', j['status'])}")
                 for j in display_jobs), default=6
            ))
            name_w = min(18, max((len(j["name"]) for j in display_jobs), default=4))
            gpu_w = min(16, max((len(",".join(str(g) for g in j["gpus"])) for j in display_jobs), default=4))
            fixed = id_w + p_w + q_w + st_w + name_w + gpu_w + 6 * 3
            cmd_w = max(16, term_w - 2 - fixed)
            widths = [id_w, p_w, q_w, st_w, name_w, gpu_w, cmd_w]
            headers = ["ID", "P", "Queue", "Status", "Name", "GPUs", "Command"]

            b = BOX
            sep_h = b["h"]
            out.append(b["tl"] + b["mt"].join(sep_h * w for w in widths) + b["tr"])
            out.append(b["v"] + b["v"].join(_pad(h, w) for h, w in zip(headers, widths)) + b["v"])
            out.append(b["ml"] + b["x"].join(sep_h * w for w in widths) + b["mr"])

            for di, job in enumerate(display_jobs):
                abs_idx = self._scroll + di
                selected = abs_idx == self._cursor
                prefix = "▶" if selected else " "
                q = job.get("queue", "default")
                sa = job.get("scheduled_after")
                sched = ""
                if sa:
                    t = parse_time(sa)
                    if t and t > now():
                        sched = f" ⏳{t.strftime('%m-%d %H:%M')}"
                        if _cell_width(sched) > cmd_w - 10:
                            sched = ""
                cmd_text = shorten(job["command"], cmd_w - len(sched) - 2)
                if sched and "…" not in cmd_text:
                    cmd_text = cmd_text + sched
                cells: list[str] = [
                    prefix + str(job["id"]),
                    priority_symbol(int(job.get("priority", 0))),
                    style(q, queue_color(q)),
                    render_job_status(job["status"]),
                    shorten(job["name"], name_w),
                    ",".join(str(g) for g in job["gpus"]),
                    cmd_text,
                ]
                row = b["v"] + b["v"].join(_pad(c, w) for c, w in zip(cells, widths)) + b["v"]
                if selected:
                    out.append(style(row, "white"))
                else:
                    out.append(row)
            out.append(b["bl"] + b["mb"].join(sep_h * w for w in widths) + b["br"])
            out.append(f"  {self._scroll + 1}-{self._scroll + len(display_jobs)} / {len(self._jobs)}")
        else:
            out.append(style("  (empty)", "gray", dim=True))

        out.append("")

        # Message
        if self._message:
            out.append(style(f"  {self._message}", "bright_yellow"))

        # Status bar
        sort_label = {"priority": "priority↓", "id": "id↑", "status": "status"}.get(self._sort_mode, self._sort_mode)
        bar_w = min(term_w - 2, 120)
        out.append(style("─" * bar_w, "gray"))
        keys = [
            "q:quit", "a:add", "c:cancel", "x:del", "r:retry",
            "p:prio", "↑↓:nav", "Enter:detail", "l:logs",
            "d:daemon", "f:filter", "s:sort", "?:help",
        ]
        key_line = "  ".join(keys)
        if _cell_width(key_line) > term_w - 5:
            key_line = "  ".join(keys[:8])
        out.append(style(key_line, "gray") + f"   [{sort_label}]")
        out.append("")

        # Modal overlay
        if self._modal:
            out.extend(self._render_modal())

        return "\r\n".join(out)

    def _count_overhead(self, lines_before_jobs: list[str]) -> int:
        return len(lines_before_jobs)



def render_summary_simple() -> str:
    try:
        with state_lock(timeout=0.5):
            state = load_state()
        return render_summary(state)
    except CliError:
        return "(状态文件忙)"


def fallback_add_form(config: dict[str, Any], metrics: list[dict[str, Any]], args: argparse.Namespace) -> dict[str, Any]:
    """Simple line-by-line prompt fallback when TTY is not available."""
    next_job_id = 1
    try:
        with state_lock():
            state = load_state()
            next_job_id = state["next_job_id"]
    except Exception:
        pass
    default_gpus = resolve_default_gpus(config, metrics)
    result: dict[str, Any] = {}
    result["cwd"] = args.cwd or prompt("运行目录", str(BASE_DIR))
    result["command"] = args.command or prompt("运行命令", allow_empty=False)
    result["name"] = args.name or prompt("任务名", derive_name(result["command"], next_job_id))
    gpu_text = args.gpus
    if gpu_text is None:
        gpu_text = prompt(
            "GPU 列表，逗号分隔，留空表示全部",
            ",".join(str(g) for g in default_gpus) if default_gpus else "all",
            allow_empty=True,
        )
    result["gpus"] = parse_gpu_list(gpu_text, default_gpus)
    result["queue"] = args.queue or prompt("队列名", config.get("default_queue", "default"), allow_empty=True) or "default"
    result["priority"] = args.priority if args.priority is not None else int(prompt("优先级", "0", allow_empty=True) or "0")
    result["conda_env"] = args.conda_env or prompt("Conda 环境（留空跳过）", "", allow_empty=True)
    schedule_raw = args.schedule_at or prompt("定时启动 (留空=立即, +2h, 2026-05-01 08:00)", "", allow_empty=True)
    result["scheduled_after"] = parse_schedule(schedule_raw) if schedule_raw else None
    return result


def parse_bool(value: str) -> bool:
    lowered = value.strip().lower()
    if lowered in {"1", "true", "yes", "y", "on"}:
        return True
    if lowered in {"0", "false", "no", "n", "off"}:
        return False
    raise CliError(f"无法解析布尔值: {value}")


def parse_gpu_list(raw: str | None, discovered: list[int] | None = None) -> list[int]:
    if raw is None:
        return discovered or []
    text = raw.strip().lower()
    if not text or text == "all":
        return discovered or []
    result = []
    for item in raw.split(","):
        value = item.strip()
        if not value:
            continue
        try:
            result.append(int(value))
        except ValueError as exc:
            raise CliError(f"GPU 列表格式错误: {raw}") from exc
    if not result:
        raise CliError("GPU 列表不能为空。")
    return sorted(dict.fromkeys(result))


def load_gpu_metrics() -> list[dict[str, Any]]:
    require_binary("nvidia-smi")
    cmd = [
        "nvidia-smi",
        "--query-gpu=index,name,utilization.gpu,memory.used,memory.total",
        "--format=csv,noheader,nounits",
    ]
    proc = run_command(cmd)
    metrics: list[dict[str, Any]] = []
    for line in proc.stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        parts = [item.strip() for item in line.split(",")]
        if len(parts) != 5:
            continue
        metrics.append(
            {
                "index": int(parts[0]),
                "name": parts[1],
                "util": int(parts[2]),
                "mem_used": int(parts[3]),
                "mem_total": int(parts[4]),
            }
        )
    if not metrics:
        raise CliError("没有拿到 GPU 信息，请检查 nvidia-smi 输出。")
    return metrics


def gpu_index_list(metrics: list[dict[str, Any]]) -> list[int]:
    return [item["index"] for item in metrics]


def screen_sessions() -> list[str]:
    require_binary("screen")
    proc = run_command(["screen", "-ls"], check=False)
    sessions = []
    for line in proc.stdout.splitlines():
        match = re.search(r"\s+\d+\.([^\s]+)\s+\(", line)
        if match:
            sessions.append(match.group(1))
    return sessions


def screen_exists(session_name: str) -> bool:
    return session_name in screen_sessions()


def _cell_width(text: str) -> int:
    stripped = re.sub(r"\033\[[0-9;]*m", "", text)
    return len(stripped)


def _pad(text: str, width: int) -> str:
    need = max(0, width - _cell_width(text))
    return text + " " * need


def table(headers: list[str], rows: list[list[str]]) -> str:
    widths = [max(_cell_width(h), max((_cell_width(c) for c in col), default=0)) for h, col in zip(headers, zip(*rows))] if rows else [_cell_width(h) for h in headers]
    if not widths:
        return ""
    sep_h = BOX["h"]
    sep_v = BOX["v"]
    tl, tr, bl, br = BOX["tl"], BOX["tr"], BOX["bl"], BOX["br"]
    ml, mr, mt, mb, x = BOX["ml"], BOX["mr"], BOX["mt"], BOX["mb"], BOX["x"]

    def _row(cells: list[str], left: str, mid: str, right: str, pad_char: str = " ") -> str:
        padded = [_pad(c, w) if pad_char == " " else pad_char * w for c, w in zip(cells, widths)]
        return left + mid.join(padded) + right

    top = _row([sep_h * w for w in widths], tl, mt, tr)
    hdr = _row(headers, sep_v, sep_v, sep_v)
    div = _row([sep_h * w for w in widths], ml, x, mr)
    bot = _row([sep_h * w for w in widths], bl, mb, br)

    lines = [top, hdr, div]
    for row in rows:
        lines.append(_row(row, sep_v, sep_v, sep_v))
    lines.append(bot)
    return "\n".join(lines)


def job_sort_key(job: dict[str, Any]) -> tuple[int, int]:
    return (-int(job.get("priority", 0)), int(job["id"]))


def first_job(state: dict[str, Any], status: str, queue: str | None = None) -> dict[str, Any] | None:
    candidates = [
        job
        for job in sorted(state["jobs"], key=job_sort_key)
        if job["status"] == status
        and (queue is None or job.get("queue", "default") == queue)
    ]
    for job in candidates:
        scheduled = job.get("scheduled_after")
        if scheduled:
            sa = parse_time(scheduled)
            if sa and sa > now():
                continue
        return job
    return None


def find_job(state: dict[str, Any], job_id: int) -> dict[str, Any]:
    for job in state["jobs"]:
        if job["id"] == job_id:
            return job
    raise CliError(f"找不到任务 {job_id}")


def prune_history(state: dict[str, Any], limit: int) -> None:
    finished = [job for job in state["jobs"] if job["status"] in {"completed", "failed", "canceled"}]
    finished.sort(key=lambda item: item["id"])
    overflow = max(0, len(finished) - limit)
    if overflow <= 0:
        return
    delete_ids = {job["id"] for job in finished[:overflow]}
    state["jobs"] = [job for job in state["jobs"] if job["id"] not in delete_ids]


def resolve_default_gpus(config: dict[str, Any], metrics: list[dict[str, Any]]) -> list[int]:
    return parse_gpu_list(config.get("default_gpus", ""), gpu_index_list(metrics))


def create_job(
