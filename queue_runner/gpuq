def cmd_config_set(args: argparse.Namespace) -> int:
    ensure_layout()
    with state_lock():
        config = load_config()
        config[args.key] = coerce_config_value(args.key, args.value)
        save_config(config)
    print(f"配置已更新: {args.key}={config[args.key]}")
    return 0


def cmd_config_reset(_: argparse.Namespace) -> int:
    ensure_layout()
    with state_lock():
        save_config(DEFAULT_CONFIG.copy())
    print("配置已重置为默认值。")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="gpuq",
        description="GPU 排队调度器：等待指定 GPU 空闲后，在 screen 中按队列顺序运行任务。",
    )
    sub = parser.add_subparsers(dest="command")

    init_p = sub.add_parser("init", help="初始化运行目录")
    init_p.set_defaults(func=cmd_init)

    doctor_p = sub.add_parser("doctor", help="检查依赖和目录")
    doctor_p.set_defaults(func=cmd_doctor)

    add_p = sub.add_parser("add", help="添加一个排队任务")
    add_p.add_argument("--name", help="任务名")
    add_p.add_argument("--cwd", help="运行目录")
    add_p.add_argument("--command", help="执行命令，通常是 sh 脚本")
    add_p.add_argument("--gpus", help="GPU 列表，如 0,1,2；留空或 all 表示全部")
    add_p.add_argument("--queue", help="目标队列名")
    add_p.add_argument("--priority", type=int, help="优先级，数字越大越优先")
    add_p.add_argument("--schedule-at", help="定时启动: +2h, +30m, 2026-05-01 08:00")
    add_p.add_argument("--conda-env", help="Conda 环境名（自动 source conda.sh 并 activate）")
    add_p.add_argument("--launch-hold-s", type=int, help="任务启动后的保护时间")
    add_p.add_argument("--idle-util-threshold", type=int, help="判定空闲的 util 阈值")
    add_p.add_argument("--idle-mem-threshold-mb", type=int, help="判定空闲的显存阈值")
    add_p.add_argument("--idle-streak-required", type=int, help="连续空闲多少轮后启动")
    add_p.add_argument(
        "--set-cuda-visible-devices",
        type=parse_bool,
        help="是否自动注入 CUDA_VISIBLE_DEVICES=true/false",
    )
    add_p.set_defaults(func=cmd_add)

    list_p = sub.add_parser("list", help="查看队列")
    list_p.add_argument("--all", action="store_true", help="包含已完成和失败的历史任务")
    list_p.add_argument("--queue", help="只显示指定队列")
    list_p.set_defaults(func=cmd_list)

    queues_p = sub.add_parser("queues", help="查看所有队列概览")
    queues_p.set_defaults(func=cmd_queues)

    prio_p = sub.add_parser("prioritize", help="修改任务优先级")
    prio_p.add_argument("job_id", type=int)
    prio_p.add_argument("priority", type=int)
    prio_p.set_defaults(func=cmd_prioritize)

    show_p = sub.add_parser("show", help="查看单个任务详情")
    show_p.add_argument("job_id", type=int)
    show_p.set_defaults(func=cmd_show)

    status_p = sub.add_parser("status", help="查看 GPU 和队列状态")
    status_p.add_argument("--all", action="store_true", help="展示完整历史")
    status_p.set_defaults(func=cmd_status)

    remove_p = sub.add_parser("remove", help="删除非运行中的任务")
    remove_p.add_argument("job_id", type=int)
    remove_p.set_defaults(func=cmd_remove)

    cancel_p = sub.add_parser("cancel", help="取消任务")
    cancel_p.add_argument("job_id", type=int)
    cancel_p.add_argument("--force", action="store_true", help="强制停止运行中的 screen 会话")
    cancel_p.set_defaults(func=cmd_cancel)

    retry_p = sub.add_parser("retry", help="把已结束任务重新排回队列")
    retry_p.add_argument("job_id", type=int)
    retry_p.set_defaults(func=cmd_retry)

    logs_p = sub.add_parser("logs", help="查看任务日志尾部")
    logs_p.add_argument("job_id", type=int)
    logs_p.add_argument("--lines", type=int, default=50)
    logs_p.set_defaults(func=cmd_logs)

    run_p = sub.add_parser("run", help="前台运行调度器")
    run_p.add_argument("--once", action="store_true", help="只跑一轮检测")
    run_p.add_argument("--quiet", action="store_true", help="不打印 dashboard")
    run_p.add_argument("--queue", help="只处理指定队列")
    run_p.add_argument("--poll-interval", type=int, help="覆盖轮询间隔")
