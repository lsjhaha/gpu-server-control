def cmd_add(args: argparse.Namespace) -> int:
    ensure_layout()
    metrics = load_gpu_metrics()
    with state_lock():
        config = load_config()
        state = load_state()
        next_job_id = state["next_job_id"]
        default_gpus = resolve_default_gpus(config, metrics)

    has_cli_overrides = any(
        getattr(args, a, None) is not None
        for a in ("name", "command", "cwd", "gpus", "queue", "priority", "schedule_at", "conda_env")
    )

    form_defaults: dict[str, Any] = {
        "name": args.name or "",
        "command": args.command or "",
        "cwd": args.cwd or "",
        "gpus": args.gpus or "",
        "queue": args.queue or config.get("default_queue", "default"),
        "priority": args.priority if args.priority is not None else config.get("default_priority", 0),
        "schedule": "",
        "conda_env": args.conda_env or config.get("default_conda_env", ""),
        "launch_hold_s": str(args.launch_hold_s) if args.launch_hold_s else "",
    }

    if args.schedule_at:
        form_defaults["schedule"] = args.schedule_at

    form_data: dict[str, Any] | None = None

    if not has_cli_overrides:
        form = InteractiveForm(form_defaults, metrics)
        form_data = form.run()

    if form_data is None:
        if has_cli_overrides:
            form_data = {}
        else:
            form_data = fallback_add_form(config, metrics, args)

    name = form_data.get("name") or args.name or prompt("任务名", derive_name(form_data.get("command", "cmd"), next_job_id))
    command = form_data.get("command") or args.command or prompt("运行命令", allow_empty=False)
    cwd = form_data.get("cwd") or args.cwd or prompt("运行目录", str(BASE_DIR))
    gpu_text = form_data.get("gpus") or args.gpus
    if gpu_text is None:
        gpu_text = prompt(
            "GPU 列表，逗号分隔，留空表示全部",
            ",".join(str(g) for g in default_gpus) if default_gpus else "all",
            allow_empty=True,
        )
    gpus = parse_gpu_list(gpu_text, default_gpus)
    queue = (form_data.get("queue") if form_data and form_data.get("queue") else None) or args.queue or config.get("default_queue", "default")
    priority_raw = form_data.get("priority", "") if form_data else ""
    if priority_raw and str(priority_raw).strip():
        priority_val = int(priority_raw)
    elif args.priority is not None:
        priority_val = args.priority
    else:
        priority_val = int(config.get("default_priority", 0))
    schedule_raw = (form_data.get("schedule", "") if form_data else "") or args.schedule_at or ""
    scheduled_after = parse_schedule(schedule_raw) if schedule_raw else None

    with state_lock():
        state = load_state()
        config = load_config()
        conda_env = (form_data.get("conda_env") if form_data and form_data.get("conda_env") else None) or args.conda_env or ""
        job = create_job(
            state,
            config,
            name=name,
            cwd=cwd,
            command=command,
            gpus=gpus,
            queue=queue,
            priority=priority_val,
            scheduled_after=scheduled_after,
            conda_env=conda_env if conda_env else None,
            launch_hold_s=args.launch_hold_s,
            idle_util_threshold=args.idle_util_threshold,
            idle_mem_threshold_mb=args.idle_mem_threshold_mb,
            idle_streak_required=args.idle_streak_required,
            set_cuda_visible_devices=args.set_cuda_visible_devices,
        )
        save_state(state)
    print(style(f"已加入队列: job {job['id']}", "green", bold=True))
    print(render_job_detail(job))
    return 0


