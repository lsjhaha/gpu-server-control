class SchedulerRuntime:
    def __init__(self, target_queue: str | None = None) -> None:
        self.head_job_id: int | None = None
        self.idle_streak = 0
        self.last_message = ""
        self.target_queue = target_queue

    def update_idle_streak(self, job_id: int, idle: bool) -> int:
        if self.head_job_id != job_id:
            self.head_job_id = job_id
            self.idle_streak = 0
        if idle:
            self.idle_streak += 1
        else:
            self.idle_streak = 0
        return self.idle_streak


def scheduler_tick(runtime: SchedulerRuntime) -> dict[str, Any]:
    metrics = load_gpu_metrics()
    snapshot: dict[str, Any] = {
        "metrics": metrics,
        "event": "",
        "idle_reasons": [],
        "running_job": None,
        "head_job": None,
        "idle_streak": runtime.idle_streak,
        "target_queue": runtime.target_queue,
    }

    with state_lock():
        state = load_state()
        config = load_config()
        running_job = first_job(state, "running", queue=runtime.target_queue)
        snapshot["state"] = state
        snapshot["config"] = config
        if running_job:
            snapshot["running_job"] = json.loads(json.dumps(running_job))
            session = running_job.get("screen_session")
            if session and not screen_exists(session):
                finish_running_job(running_job)
                prune_history(state, int(config["history_limit"]))
                save_state(state)
                snapshot["event"] = f"任务 {running_job['id']} 已结束，退出码 {running_job['exit_code']}"
                snapshot["running_job"] = None
                running_job = None
        if not running_job:
            head = first_job(state, "queued", queue=runtime.target_queue)
            if head:
                snapshot["head_job"] = json.loads(json.dumps(head))
                idle, reasons = gpu_idle_reason(head, metrics)
                streak = runtime.update_idle_streak(head["id"], idle)
                snapshot["idle_streak"] = streak
                snapshot["idle_reasons"] = reasons
                if idle and streak >= int(head["idle_streak_required"]):
                    try:
                        session, log_path = launch_job(head, config)
                        save_state(state)
                        snapshot["event"] = f"任务 {head['id']} 已启动，screen={session}，log={log_path}"
                        snapshot["running_job"] = json.loads(json.dumps(head))
                        snapshot["head_job"] = None
                        runtime.idle_streak = 0
                    except Exception as exc:
                        head["status"] = "failed"
                        head["finished_at"] = now_iso()
                        head["exit_code"] = -1
                        head["notes"].append(str(exc))
                        save_state(state)
                        snapshot["event"] = f"任务 {head['id']} 启动失败: {exc}"
            else:
                runtime.head_job_id = None
                runtime.idle_streak = 0
    return snapshot


def render_snapshot(snapshot: dict[str, Any]) -> str:
    state = snapshot["state"]
    running_job = snapshot["running_job"]
    head_job = snapshot["head_job"]
    target_queue = snapshot.get("target_queue")
    queue_label = f" [{target_queue}]" if target_queue else ""

    gpu_filter = set(running_job["gpus"]) if running_job else (set(head_job["gpus"]) if head_job else None)

    lines = [
        banner("╔══════════════════════════════════════╗"),
        banner("║      GPU Queue Dashboard" + queue_label.ljust(21) + "║"),
        banner("╚══════════════════════════════════════╝"),
        f"  更新时间: {format_time(now_iso())}",
        "",
        banner("▸ GPU 状态"),
        render_gpu_table(snapshot["metrics"], gpu_filter=gpu_filter),
        "",
        banner("▸ 任务概览"),
        render_summary(state),
        "",
        banner("▸ 运行中"),
    ]
    if running_job:
        hold_until = parse_time(running_job.get("hold_until"))
        hold_info = "-"
        if hold_until:
            remain = (hold_until - now()).total_seconds()
            hold_info = format_duration(remain) if remain > 0 else "0s"
        lines.extend(
            [
                f"   job {running_job['id']}  {style(running_job['name'], 'bright_green', bold=True)}",
                f"   queue: {style(running_job.get('queue', 'default'), queue_color(running_job.get('queue', 'default')))}",
                f"   screen: {running_job.get('screen_session') or '-'}",
                f"   log: {running_job.get('log_path') or '-'}",
                f"   hold: {hold_info}",
            ]
        )
    else:
        lines.append("   当前没有运行中的任务。")
    lines.extend(["", banner("▸ 队首候选")])
    if head_job:
        sa = head_job.get("scheduled_after")
        sa_info = ""
        if sa:
            t = parse_time(sa)
            if t and t > now():
                remain = (t - now()).total_seconds()
                sa_info = f"  ⏳ 等待至 {format_time(sa)} (剩余 {format_duration(remain)})"
        lines.extend(
            [
                f"   job {head_job['id']}  {style(head_job['name'], 'bright_yellow', bold=True)}",
                f"   queue: {style(head_job.get('queue', 'default'), queue_color(head_job.get('queue', 'default')))}  priority: {head_job.get('priority', 0)}{sa_info}",
                f"   gpus: {','.join(str(g) for g in head_job['gpus'])}",
                f"   idle streak: {snapshot['idle_streak']} / {head_job['idle_streak_required']}",
            ]
        )
        if snapshot["idle_reasons"]:
            lines.append("   busy: " + style("; ".join(snapshot["idle_reasons"]), "red"))
        else:
            lines.append("   busy: " + style("GPU 空闲，等待 streak 满足后启动", "green"))
    else:
        lines.append("   当前没有排队任务。")
    lines.extend(
        [
            "",
            banner("▸ 队列"),
            render_jobs(state, include_done=False),
        ]
    )
    if snapshot["event"]:
        lines.extend(["", banner("▸ 事件"), f"   {snapshot['event']}"])
    return "\n".join(lines)


def cmd_run(args: argparse.Namespace) -> int:
    ensure_layout()
    runtime = SchedulerRuntime(target_queue=args.queue)
    with state_lock():
        config = load_config()
    poll_interval = int(args.poll_interval or config["poll_interval_s"])
    try:
        while True:
            snapshot = scheduler_tick(runtime)
            if args.quiet:
                if snapshot["event"]:
                    print(f"[{format_time(now_iso())}] {snapshot['event']}", flush=True)
            else:
                clear_screen()
                print(render_snapshot(snapshot))
            if args.once:
                break
            time.sleep(max(1, poll_interval))
    except KeyboardInterrupt:
        if not args.quiet:
            print("\n已停止前台调度。")
    return 0


def cmd_daemon_start(_: argparse.Namespace) -> int:
    ensure_layout()
    config = load_config()
    session = config["daemon_session_name"]
    if screen_exists(session):
        print(f"守护进程已在运行: {session}")
        return 0
    log_path = daemon_log_path()
    cmd = (
        f"cd {shlex.quote(str(BASE_DIR))} && "
        f"exec {shlex.quote(sys.executable)} {shlex.quote(str(BASE_DIR / 'gpuq'))} run --quiet "
        f">> {shlex.quote(str(log_path))} 2>&1"
    )
    proc = run_command(["screen", "-dmS", session, "/bin/bash", "-lc", cmd], check=False)
    if proc.returncode != 0:
        raise CliError(f"守护进程启动失败: {proc.stderr.strip()}")
    time.sleep(1)
    if not screen_exists(session):
        raise CliError("守护进程 screen 会话没有成功启动。")
    print(f"守护进程已启动: {session}")
    print(f"log: {log_path}")
    return 0


def cmd_daemon_stop(_: argparse.Namespace) -> int:
    ensure_layout()
    config = load_config()
    session = config["daemon_session_name"]
    if not screen_exists(session):
        print("守护进程未运行。")
        return 0
    run_command(["screen", "-S", session, "-X", "quit"], check=False)
    time.sleep(1)
    print(f"守护进程已停止: {session}")
    return 0


